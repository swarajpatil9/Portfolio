# ─────────────────────────────────────────────────────────────────────────────
# API Configuration
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to source control.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of your REST API (no trailing slash).
# When this is empty the app runs in offline mode using localStorage only.
VITE_API_BASE_URL=https://api.example.com

# Static API key sent in every request via the x-api-key header.
VITE_API_KEY=your_api_key_here
